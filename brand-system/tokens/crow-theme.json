          "foreground": "#45E7FF",
          "background": "rgba(69, 231, 255, 0.10)",
          "border": "rgba(69, 231, 255, 0.42)",
          "onSolid": "#03040A"
        }
      }
    }
  },
  "typography": {
    "release": "Crow Bitfeather v0.3.0",
    "construction": "Solid stepped-pixel CrowClaw letterforms with slightly thickened strokes for clarity at interface sizes.",
    "family": {
      "display": "\"Crow Bitfeather Display\", \"Segoe UI Variable Display\", \"Segoe UI\", sans-serif",
      "body": "\"Crow Bitfeather Mono\", \"Segoe UI Variable Text\", \"Segoe UI\", sans-serif",
      "mono": "\"Crow Bitfeather Mono\", \"Cascadia Mono\", Consolas, monospace"
    },
    "weight": {
      "regular": 400,
      "bold": 700
    },
    "tracking": {
      "display": "0.045em",
      "signal": "0.08em"
    }
  },
  "spacing": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.5rem",
    "6": "2rem",
    "7": "3rem"
  },
  "radius": {
    "small": "0.5rem",
    "medium": "0.75rem",
    "large": "1.125rem",
    "pill": "999px"
  },
  "shadow": {
    "raised": "0 18px 60px rgba(0, 0, 0, 0.46)",
    "signal": "0 0 28px rgba(47, 123, 255, 0.20)",
    "cyan": "0 0 24px rgba(69, 231, 255, 0.18)",
    "ultraviolet": "0 0 30px rgba(115, 76, 255, 0.22)"
  },
  "motion": {
    "duration": {
      "instant": "0ms",
      "fast": "120ms",
      "standard": "200ms",
      "deliberate": "320ms",
      "ambient": "1600ms"
    },
    "easing": {
      "enter": "cubic-bezier(0.16, 1, 0.3, 1)",
      "exit": "cubic-bezier(0.7, 0, 0.84, 0)",
      "signal": "cubic-bezier(0.22, 1, 0.36, 1)"
    },
    "distance": "8px",
    "reducedMotion": {
      "duration": "0ms",
      "distance": "0px",
      "rule": "Remove decorative movement and retain only non-moving state changes or essential progress indication."
    }
  },
