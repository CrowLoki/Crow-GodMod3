  "mascot": {
    "identityAnchor": "assets/mascots/masters/crow-mascot-v3.png",
    "activePolicy": "crow-mascot-v3 is the sole active mascot. Product variants may change crop, background and accent emphasis only.",
    "invariants": {
      "eyes": 3,
      "eyeRule": "Exactly two physical eyes and one centred forehead eye.",
      "head": "A real elongated crow head with a tapered corvid beak.",
      "bodyPlan": "A naturally proportioned adult crow; never humanoid.",
      "cybernetics": "Biomechanical systems are integrated through feathers, face, torso, wings, legs and talons rather than applied as jewellery.",
      "palette": "Black, gunmetal, navy, indigo, ultraviolet, electric blue and cyan; magenta only as a restrained iris or pulse accent.",
      "forbidden": [
        "humanoid body",
        "human clothing",
        "moon head",
        "orb head",
        "owl face",
        "plague mask",
        "human face",
        "extra eyes",
        "missing forehead eye",
        "dominant warm metallic colour",
        "baked-in text"
      ]
    },
